    "01": "hero portrait collage, subject mid, type top",
    "02": "type stack + animal footer",
    "03": "type stack + pill row + animal footer",
    "04": "type + internal boundary split + cat",
    "05": "decoder stack + small owl",
    "06": "numbered list + small owl",
    "07": "type + cat turning away",
    "08": "type + owl witness",
    "09": "hero standing 3/4 + huge magenta script above/beside"
  },
  "no_cross_gutter": ["faces", "trigger word", "headlines", "animals"]
